local function refreshPlayerList()
    playerMap = {}
    local playerNames = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local displayName = player.DisplayName .. " (@" .. player.Name .. ")"
            playerMap[displayName] = player
            table.insert(playerNames, displayName)
        end
    end

    if #playerNames > 0 then
        updateDropdownOptions(PlayerDropdown, playerNames)
    else
        updateDropdownOptions(PlayerDropdown, {"(No other players)"})
    end
end

