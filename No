-- [[ CoreGui & UI Inspector + Auto Clicker ]]
-- UI Library: WindUI

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- Services
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Variables
local autoClickAllButtons = false
local trackCoreGui = true
local trackPlayerGui = true

-- Create Window
local Window = WindUI:CreateWindow({
    Title = "UI & CoreGui Inspector",
    Icon = "layout",
    Author = "Inspector Tool",
    Folder = "UIInspector",
    Size = UDim2.fromOffset(580, 500),
    Transparent = true,
    Theme = "Dark"
})

local MainTab = Window:Tab({ Title = "UI Inspector", Icon = "monitor" })

-- Helper Functions
local function simulateClick(button)
    if not button then return end
    
    -- Method 1: GuiService / Firesignal Equivalent for Roblox UI
    for _, connection in ipairs(getconnections and getconnections(button.MouseButton1Click) or {}) do
        connection:Fire()
    end
    for _, connection in ipairs(getconnections and getconnections(button.MouseButton1Down) or {}) do
        connection:Fire()
    end
    for _, connection in ipairs(getconnections and getconnections(button.Activated) or {}) do
        connection:Fire()
    end
    
    -- Method 2: VirtualUser Backup Click
    if button:IsA("GuiButton") and button.AbsolutePosition then
        local pos = button.AbsolutePosition + (button.AbsoluteSize / 2)
        VirtualUser:Button1Down(Vector2.new(pos.X, pos.Y))
        task.wait(0.05)
        VirtualUser:Button1Up(Vector2.new(pos.X, pos.Y))
    end
end

local function inspectUI(element, sourceName)
    if not element then return end
    
    local textVal = ""
    if element:IsA("TextLabel") or element:IsA("TextButton") or element:IsA("TextBox") then
        textVal = " | Text: '" .. tostring(element.Text) .. "'"
    end
    
    print("========================================")
    print("[" .. sourceName .. " DETECTED]")
    print("Name: " .. element.Name)
    print("Class: " .. element.ClassName .. textVal)
    print("Full Path: " .. element:GetFullName())
    print("Visible: " .. tostring(element.Visible))
    print("========================================")

    WindUI:Notify({
        Title = "[" .. sourceName .. " UI]",
        Content = "Name: " .. element.Name .. "\nClass: " .. element.ClassName .. (textVal ~= "" and textVal or ""),
        Duration = 4
    })

    if autoClickAllButtons and element:IsA("GuiButton") then
        task.wait(0.1)
        simulateClick(element)
    end
end

-- UI Controls
MainTab:Section({ Title = "CoreGui Special Check" })

MainTab:Button({
    Title = "Check TeleportEffectGui State",
    Desc = "เช็คว่า TeleportEffectGui อยู่ใน CoreGui หรือไม่",
    Callback = function()
        local tpGui = CoreGui:FindFirstChild("TeleportEffectGui")
        if tpGui then
            WindUI:Notify({
                Title = "TeleportEffectGui Found!",
                Content = "Status: Present in CoreGui\nEnabled: " .. tostring(tpGui.Enabled),
                Duration = 5
            })
            print("[CORE-GUI CHECK] TeleportEffectGui found: " .. tpGui:GetFullName())
            for _, child in ipairs(tpGui:GetDescendants()) do
                print(" -> Child: " .. child.Name .. " (" .. child.ClassName .. ")")
            end
        else
            WindUI:Notify({
                Title = "Not Found",
                Content = "TeleportEffectGui is NOT currently in CoreGui",
                Duration = 3
            })
            print("[CORE-GUI CHECK] TeleportEffectGui not found.")
        end
    end
})

MainTab:Section({ Title = "Real-time UI Detector Options" })

MainTab:Toggle({
    Title = "Track PlayerGui (Game UI & Popups)",
    Default = true,
    Callback = function(state)
        trackPlayerGui = state
    end
})

MainTab:Toggle({
    Title = "Track CoreGui (System UI / Roblox Effects)",
    Default = true,
    Callback = function(state)
        trackCoreGui = state
    end
})

MainTab:Toggle({
    Title = "Auto Click Detected Buttons",
    Desc = "พยายามคลิกปุ่มอัตโนมัติทันทีเมื่อมี GuiButton ใหม่ขึ้นมา",
    Default = false,
    Callback = function(state)
        autoClickAllButtons = state
    end
})

MainTab:Section({ Title = "Manual Scanners" })

MainTab:Button({
    Title = "Scan All Buttons in PlayerGui",
    Callback = function()
        local count = 0
        for _, descendant in ipairs(PlayerGui:GetDescendants()) do
            if descendant:IsA("GuiButton") and descendant.Visible then
                count = count + 1
                inspectUI(descendant, "PLAYER-GUI BUTTON")
            end
        end
        WindUI:Notify({ Title = "Scan Complete", Content = "Found " .. tostring(count) .. " visible button(s).", Duration = 3 })
    end
})

-- Real-time UI Watcher
task.spawn(function()
    -- Watch PlayerGui
    PlayerGui.DescendantAdded:Connect(function(descendant)
        if trackPlayerGui then
            task.wait(0.05)
            inspectUI(descendant, "PLAYER-GUI")
        end
    end)

    -- Watch CoreGui
    CoreGui.DescendantAdded:Connect(function(descendant)
        if trackCoreGui then
            task.wait(0.05)
            inspectUI(descendant, "CORE-GUI")
            
            -- Specific check for TeleportEffectGui
            if descendant.Name == "TeleportEffectGui" or descendant:IsDescendantOf(CoreGui:FindFirstChild("TeleportEffectGui") or Workspace) then
                WindUI:Notify({
                    Title = "[TELEPORT EFFECT ACTIVE]",
                    Content = "TeleportEffectGui triggered in CoreGui!",
                    Duration = 5
                })
            end
        end
    end)
end)

WindUI:Notify({
    Title = "UI Inspector Ready",
    Content = "Monitoring PlayerGui and CoreGui...",
    Duration = 4
})
