-- [[ DropsClient Auto Scanner & Dynamic Dropdown UI (Fixed) ]]
-- UI Library: WindUI

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- Services
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- Variables
local autoLoopFarmDrops = false
local farmDelay = 0.2
local selectedRarities = {}
local selectedItemNames = {}

-- Store unique scanned data
local scannedRarities = {}
local scannedNames = {}

-- Create Window
local Window = WindUI:CreateWindow({
    Title = "Fix Selector Tool",
    Icon = "list-filter",
    Author = "Auto Farm Tool",
    Folder = "DropsAutoFarm",
    Size = UDim2.fromOffset(580, 520),
    Transparent = true,
    Theme = "Dark"
})

local MainTab = Window:Tab({ Title = "Dynamic Selector", Icon = "mouse-pointer" })

-- Helper Functions
local function getObjectCFrame(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then
        return obj.CFrame
    elseif obj:IsA("Model") then
        return obj.PrimaryPart and obj.PrimaryPart.CFrame or obj:GetPivot()
    end
    return nil
end

local function holdE(duration)
    task.spawn(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(duration or 1.2)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function triggerPromptsIn(parentObj)
    for _, child in ipairs(parentObj:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            fireproximityprompt(child)
        end
    end
end

local function getItemDetails(dropItemFolder)
    local root = dropItemFolder:FindFirstChild("Root")
    if not root then return "", "" end

    local dropUI = root:FindFirstChild("Drop")
    if not dropUI then return "", "" end

    local xyd = dropUI:FindFirstChild("XYD")
    local zhName = dropUI:FindFirstChild("ZhName")

    local rarity = xyd and (xyd:IsA("TextLabel") or xyd:IsA("TextBox")) and xyd.Text or ""
    local name = zhName and (zhName:IsA("TextLabel") or zhName:IsA("TextBox")) and zhName.Text or ""

    return name, rarity
end

-- UI Elements Setup
MainTab:Section({ Title = "Scanner & Dynamic Dropdowns" })

local RarityDropdown = MainTab:Dropdown({
    Title = "Select Rarities (เลือก Rarity)",
    Desc = "เลือก Rarity ที่ต้องการเก็บ",
    Values = {},
    Multi = true,
    Default = {},
    Callback = function(values)
        selectedRarities = values or {}
    end
})

local NameDropdown = MainTab:Dropdown({
    Title = "Select Item Names (เลือกชื่อของ)",
    Desc = "เลือกชื่อไอเทมที่ต้องการเก็บ",
    Values = {},
    Multi = true,
    Default = {},
    Callback = function(values)
        selectedItemNames = values or {}
    end
})

-- Safe Update Dropdown Helper
local function updateDropdownOptions(dropdown, newValues)
    if not dropdown then return end
    
    -- ตรวจสอบ Method การอัปเดตของ WindUI
    if dropdown.SetValues then
        dropdown:SetValues(newValues)
    elseif dropdown.Refresh then
        dropdown:Refresh(newValues)
    elseif dropdown.Update then
        dropdown:Update(newValues)
    elseif dropdown.Values then
        dropdown.Values = newValues
    end
end

-- Scanner Function
local function scanDropsClient()
    local dropsClientFolder = Workspace:FindFirstChild("DropsClient")
    if not dropsClientFolder then
        WindUI:Notify({ Title = "Error", Content = "Workspace.DropsClient not found!", Duration = 3 })
        return
    end

    local foundRarityMap = {}
    local foundNameMap = {}
    local newRarities = {}
    local newNames = {}

    for _, childFolder in ipairs(dropsClientFolder:GetChildren()) do
        for _, dropItemFolder in ipairs(childFolder:GetChildren()) do
            local itemName, itemRarity = getItemDetails(dropItemFolder)

            if itemRarity ~= "" and not foundRarityMap[itemRarity] then
                foundRarityMap[itemRarity] = true
                table.insert(newRarities, itemRarity)
            end

            if itemName ~= "" and not foundNameMap[itemName] then
                foundNameMap[itemName] = true
                table.insert(newNames, itemName)
            end
        end
    end

    scannedRarities = newRarities
    scannedNames = newNames

    -- อัปเดต Dropdowns
    if #scannedRarities > 0 then
        updateDropdownOptions(RarityDropdown, scannedRarities)
    end
    
    if #scannedNames > 0 then
        updateDropdownOptions(NameDropdown, scannedNames)
    end

    WindUI:Notify({
        Title = "Scan Completed",
        Content = "Found " .. tostring(#scannedRarities) .. " Rarities & " .. tostring(#scannedNames) .. " Item Names!",
        Duration = 4
    })
end

MainTab:Button({
    Title = "Scan Drops & Update Dropdowns",
    Desc = "สแกนของในแมปเพื่อนำชื่อและ Rarity ทั้งหมดมาใส่ใน Dropdown",
    Callback = function()
        task.spawn(function()
            scanDropsClient()
        end)
    end
})

-- Check Logic (OR Matching)
local function checkCanCollect(itemName, itemRarity)
    local hasNameFilter = #selectedItemNames > 0
    local hasRarityFilter = #selectedRarities > 0

    if not hasNameFilter and not hasRarityFilter then
        return true
    end

    local nameMatched = false
    local rarityMatched = false

    if hasNameFilter then
        for _, name in ipairs(selectedItemNames) do
            if string.find(string.lower(itemName), string.lower(name), 1, true) then
                nameMatched = true
                break
            end
        end
    end

    if hasRarityFilter then
        for _, rarity in ipairs(selectedRarities) do
            if string.find(string.lower(itemRarity), string.lower(rarity), 1, true) then
                rarityMatched = true
                break
            end
        end
    end

    return rarityMatched or nameMatched
end

-- Auto Farm Loop
local function collectAllDrops()
    local dropsClientFolder = Workspace:FindFirstChild("DropsClient")
    if not dropsClientFolder then return end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local originalCFrame = hrp and hrp.CFrame

    for _, childFolder in ipairs(dropsClientFolder:GetChildren()) do
        if not autoLoopFarmDrops then break end
        
        for _, dropItemFolder in ipairs(childFolder:GetChildren()) do
            if not autoLoopFarmDrops then break end
            
            local itemName, itemRarity = getItemDetails(dropItemFolder)

            if checkCanCollect(itemName, itemRarity) then
                local targetCFrame = getObjectCFrame(dropItemFolder)
                
                if hrp and targetCFrame then
                    hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                    
                    triggerPromptsIn(dropItemFolder)
                    holdE(0.8)
                    
                    if originalCFrame then
                        hrp.CFrame = originalCFrame
                    end
                    
                    task.wait(farmDelay)
                end
            end
        end
    end
end

MainTab:Section({ Title = "Auto Farm Controls" })

MainTab:Toggle({
    Title = "Auto Farm Selected Items",
    Desc = "วนลูปเก็บเฉพาะของที่เลือกใน Dropdown และวาร์ปกลับจุดเดิม",
    Default = false,
    Callback = function(state)
        autoLoopFarmDrops = state
        if autoLoopFarmDrops then
            WindUI:Notify({ Title = "Auto Farm", Content = "Started Farm Loop!", Duration = 2 })
            task.spawn(function()
                while autoLoopFarmDrops do
                    collectAllDrops()
                    task.wait(0.5)
                end
            end)
        else
            WindUI:Notify({ Title = "Auto Farm", Content = "Stopped Farm Loop!", Duration = 2 })
        end
    end
})

MainTab:Slider({
    Title = "Farm Delay Speed",
    Min = 0.05,
    Max = 2.0,
    Default = 0.2,
    Step = 0.05,
    Callback = function(val)
        farmDelay = val
    end
})

-- Auto-Scan once when loaded
task.spawn(function()
    task.wait(1.5)
    scanDropsClient()
end)

WindUI:Notify({
    Title = "Dynamic Dropdown Selector Loaded",
    Content = "Press 'Scan Drops' to refresh dropdown list!",
    Duration = 4
})
