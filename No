    if not config then return end

    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not requestFunc then return end

    local isAstral = (rarityKey == "astral realm")
    local pingMs = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())

    local descriptionText = string.format("ผู้เล่น **%s** สไนป์ไอเทมระดับ **%s** สำเร็จ!", LocalPlayer.Name, itemRarity)
