local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- Variables
local autoLoopFarmDrops = false
local farmDelay = 0.2
local targetItemNames = {}  -- รายชื่อของที่ต้องการเก็บเป็นพิเศษ
local targetRarities = {}   -- รายชื่อ Rarity ที่ต้องการเก็บ

-- Create Window
local Window = WindUI:CreateWindow({
    Title = "DropsClient Auto Farm V5",
    Icon = "package",
    Author = "Auto Farm Tool",
    Folder = "DropsAutoFarm",
    Size = UDim2.fromOffset(550, 500),
    Transparent = true,
    Theme = "Dark"
})

local MainTab = Window:Tab({ Title = "Auto Farm Filter", Icon = "filter" })

-- Helper Functions
local function getObjectCFrame(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then
        return obj.CFrame
    elseif obj:IsA("Model") then
        return obj.PrimaryPart and obj.PrimaryPart.CFrame or obj:GetPivot()
    end
    return nil
end

local function holdE(duration)
    task.spawn(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(duration or 1.2)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function triggerPromptsIn(parentObj)
    for _, child in ipairs(parentObj:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            fireproximityprompt(child)
        end
    end
end

-- Separate words by comma
local function parseInputList(text)
    local list = {}
    if not text or text == "" then return list end
    for item in string.gmatch(text, "([^,]+)") do
        local cleaned = string.lower(string.match(item, "^%s*(.-)%s*$"))
        if cleaned ~= "" then
            table.insert(list, cleaned)
        end
    end
    return list
end

-- Get Item Text Info
local function getItemDetails(dropItemFolder)
    local root = dropItemFolder:FindFirstChild("Root")
    if not root then return "", "" end

    local dropUI = root:FindFirstChild("Drop")
    if not dropUI then return "", "" end

    local xyd = dropUI:FindFirstChild("XYD")
    local zhName = dropUI:FindFirstChild("ZhName")

    local rarity = xyd and (xyd:IsA("TextLabel") or xyd:IsA("TextBox")) and xyd.Text or ""
    local name = zhName and (zhName:IsA("TextLabel") or zhName:IsA("TextBox")) and zhName.Text or ""

    return name, rarity
end

-- Flexible Match Checker (OR Logic)
local function checkCanCollect(itemName, itemRarity)
    local hasNameFilter = #targetItemNames > 0
    local hasRarityFilter = #targetRarities > 0

    -- 1. ถ้าไม่ได้ใส่ช่องไหนเลย = เก็บหมดทุกชิ้น
    if not hasNameFilter and not hasRarityFilter then
        return true
    end

    local nameMatched = false
    local rarityMatched = false

    local nameLower = string.lower(itemName)
    local rarityLower = string.lower(itemRarity)

    if hasNameFilter then
        for _, filter in ipairs(targetItemNames) do
            if string.find(nameLower, filter, 1, true) then
                nameMatched = true
                break
            end
        end
    end

    if hasRarityFilter then
        for _, filter in ipairs(targetRarities) do
            if string.find(rarityLower, filter, 1, true) then
                rarityMatched = true
                break
            end
        end
    end

    -- 2. ขอแค่ Rarity ตรง หรือ ชื่อตรง อย่างใดอย่างหนึ่งผ่าน = เก็บได้ทันที!
    return rarityMatched or nameMatched
end

-- Collect Loop
local function collectAllDrops()
    local dropsClientFolder = Workspace:FindFirstChild("DropsClient")
    if not dropsClientFolder then return end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local originalCFrame = hrp and hrp.CFrame

    for _, childFolder in ipairs(dropsClientFolder:GetChildren()) do
        if not autoLoopFarmDrops then break end
        
        for _, dropItemFolder in ipairs(childFolder:GetChildren()) do
            if not autoLoopFarmDrops then break end
            
            local itemName, itemRarity = getItemDetails(dropItemFolder)

            if checkCanCollect(itemName, itemRarity) then
                local targetCFrame = getObjectCFrame(dropItemFolder)
                
                if hrp and targetCFrame then
                    -- Teleport to item
                    hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                    
                    -- Interact
                    triggerPromptsIn(dropItemFolder)
                    holdE(0.8)
                    
                    -- Teleport back to original position
                    if originalCFrame then
                        hrp.CFrame = originalCFrame
                    end
                    
                    task.wait(farmDelay)
                end
            end
        end
    end
end

