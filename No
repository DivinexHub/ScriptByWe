        end)
    end
})

local function checkCanCollect(itemName, itemRarity)
    local hasNameFilter = #selectedItemNames > 0
    local hasRarityFilter = #selectedRarities > 0

    if not hasNameFilter and not hasRarityFilter then
        return true
    end

    local nameMatched = false
    local rarityMatched = false

    if hasNameFilter then
        for _, name in ipairs(selectedItemNames) do
            if string.find(string.lower(itemName), string.lower(name), 1, true) then
                nameMatched = true
                break
            end
        end
    end

    if hasRarityFilter then
        for _, rarity in ipairs(selectedRarities) do
            if string.find(string.lower(itemRarity), string.lower(rarity), 1, true) then
                rarityMatched = true
                break
            end
        end
    end

    return rarityMatched or nameMatched
end

local function collectAllDrops()
    local dropsClientFolder = Workspace:FindFirstChild("DropsClient")
    if not dropsClientFolder then return end

    local validItemsList = {}

    for _, childFolder in ipairs(dropsClientFolder:GetChildren()) do
        for _, dropItemFolder in ipairs(childFolder:GetChildren()) do
            local itemName, itemRarity = getItemDetails(dropItemFolder)

            if checkCanCollect(itemName, itemRarity) then
                local rarityLower = string.lower(itemRarity)
                local priorityValue = rarityPriority[rarityLower] or 0

                table.insert(validItemsList, {
                    folder = dropItemFolder,
                    name = itemName,
                    rarity = itemRarity,
                    priority = priorityValue
                })
            end
        end
    end

    table.sort(validItemsList, function(a, b)
        return a.priority > b.priority
    end)

    for _, itemData in ipairs(validItemsList) do
        if not autoLoopFarmDrops then break end

        if itemData.folder and itemData.folder.Parent then
            triggerPromptWithoutTP(itemData.folder)
            sendWebhookNotification(itemData.name, itemData.rarity)
            task.wait(farmDelay)
        end
    end
end

