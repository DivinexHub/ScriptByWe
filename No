-- REMOTE EVENT DETECTOR (HOOK / LISTEN)
local function setupStageDetector()
    local netWorkEvent = ReplicatedStorage:FindFirstChild("Msg") 
        and ReplicatedStorage.Msg:FindFirstChild("RemoteEvent") 
        and ReplicatedStorage.Msg.RemoteEvent:FindFirstChild("NetWorkRemoteEvent")

    if not netWorkEvent then return end

    netWorkEvent.OnClientEvent:Connect(function(...)
        local args = {...}
        if args[1] == STAGE_EVENT_CMD and type(args[2]) == "number" then
            local stageNum = args[2]
            currentDetectedStage = stageNum

            pcall(function()
                if StageStatusLabel.SetTitle then
                    StageStatusLabel:SetTitle("Current Detected Stage: Stage " .. tostring(stageNum))
                end
            end)

            if autoReturnEnabled and stageNum >= selectedStage then
                returnToTown()
            end
        end
    end)
end

