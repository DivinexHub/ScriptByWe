TradeTab:Section({ Title = "Trade Action" })

TradeTab:Button({
    Title = "Send Held Item (ส่งของในมือ)",
    Desc = "ส่งไอเทมที่ถืออยู่ในมือให้ผู้เล่นที่เลือกไว้ทันที",
    Callback = function()
        if not selectedTradePlayer then
            WindUI:Notify({ Title = "Trade Error", Content = "โปรดเลือกผู้เล่นที่จะส่งของให้ก่อน!", Duration = 3 })
            return
        end

        local character = LocalPlayer.Character
        local tool = character and character:FindFirstChildOfClass("Tool")

        if not tool then
            WindUI:Notify({ Title = "Trade Error", Content = "กรุณาถือไอเทมในมือก่อนกดส่ง!", Duration = 3 })
            return
        end

        local targetUserId = selectedTradePlayer.UserId

        local event = ReplicatedStorage:FindFirstChild("Msg") 
            and ReplicatedStorage.Msg:FindFirstChild("RemoteEvent") 
            and ReplicatedStorage.Msg.RemoteEvent:FindFirstChild("NetWorkRemoteEvent")

        if event then
            pcall(function()
                event:FireServer(TRADE_COMMAND_STRING, targetUserId)
            end)

            WindUI:Notify({
                Title = "Trade Sent!",
                Content = "ส่งของ: " .. tool.Name .. "\nให้แก่: " .. selectedTradePlayer.Name,
                Duration = 4
            })
        else
            WindUI:Notify({ Title = "Trade Error", Content = "ไม่พบ NetWorkRemoteEvent!", Duration = 3 })
        end
