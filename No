-- [[ DropsClient Auto Farm V3 (Multi-Filter & Return Position) ]]
-- UI Library: WindUI

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- Variables
local autoLoopFarmDrops = false
local farmDelay = 0.2
local targetItemNames = {}  -- รายชื่อของที่ต้องการเก็บ
local targetRarities = {}   -- รายชื่อ Rarity ที่ต้องการเก็บ

-- Create Window
local Window = WindUI:CreateWindow({
    Title = "DropsClient Auto Farm V3",
    Icon = "package",
    Author = "Auto Farm Tool",
    Folder = "DropsAutoFarm",
    Size = UDim2.fromOffset(550, 500),
    Transparent = true,
    Theme = "Dark"
})

local MainTab = Window:Tab({ Title = "Auto Farm Filter", Icon = "filter" })

-- Helper Functions
local function getObjectCFrame(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then
        return obj.CFrame
    elseif obj:IsA("Model") then
        return obj.PrimaryPart and obj.PrimaryPart.CFrame or obj:GetPivot()
    end
    return nil
end

local function holdE(duration)
    task.spawn(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(duration or 1.2)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function triggerPromptsIn(parentObj)
    for _, child in ipairs(parentObj:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            fireproximityprompt(child)
        end
    end
end

-- Helper for Split String (แยกคำด้วยจุลภาค ,)
local function parseInputList(text)
    local list = {}
    if not text or text == "" then return list end
    for item in string.gmatch(text, "([^,]+)") do
        local cleaned = string.lower(string.match(item, "^%s*(.-)%s*$")) -- ลบช่องว่างส่วนเกิน
        if cleaned ~= "" then
            table.insert(list, cleaned)
        end
    end
    return list
end

-- Check Item Details (Name & Rarity)
local function getItemDetails(dropItemFolder)
    local root = dropItemFolder:FindFirstChild("Root")
    if not root then return "", "" end

    local dropUI = root:FindFirstChild("Drop")
    if not dropUI then return "", "" end

    local xyd = dropUI:FindFirstChild("XYD")
    local zhName = dropUI:FindFirstChild("ZhName")

    local rarity = xyd and (xyd:IsA("TextLabel") or xyd:IsA("TextBox")) and xyd.Text or ""
    local name = zhName and (zhName:IsA("TextLabel") or zhName:IsA("TextBox")) and zhName.Text or ""

    return name, rarity
end

-- Function Check Multi-Matches
local function isMatch(itemValue, filterList)
    if #filterList == 0 then return true end -- ถ้าไม่ได้ใส่กรองไว้ ให้ผ่านหมด
    local valLower = string.lower(itemValue)
    for _, filter in ipairs(filterList) do
        if string.find(valLower, filter, 1, true) then
            return true
        end
    end
    return false
end

-- Function: Collect Filtered Items and Return
local function collectAllDrops()
    local dropsClientFolder = Workspace:FindFirstChild("DropsClient")
    if not dropsClientFolder then return end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    -- จำตำแหน่งเดิมก่อนเริ่มวาร์ป
    local originalCFrame = hrp and hrp.CFrame

    for _, childFolder in ipairs(dropsClientFolder:GetChildren()) do
        if not autoLoopFarmDrops then break end
        
        for _, dropItemFolder in ipairs(childFolder:GetChildren()) do
            if not autoLoopFarmDrops then break end
            
            local itemName, itemRarity = getItemDetails(dropItemFolder)

            local matchName = isMatch(itemName, targetItemNames)
            local matchRarity = isMatch(itemRarity, targetRarities)

            if matchName and matchRarity then
                local targetCFrame = getObjectCFrame(dropItemFolder)
                
                if hrp and targetCFrame then
                    -- 1. วาร์ปไปหาไอเทม
                    hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                    
                    -- 2. กดเก็บของ
                    triggerPromptsIn(dropItemFolder)
                    holdE(0.8)
                    
                    -- 3. วาร์ปกลับจุดเดิมทันที
                    if originalCFrame then
                        hrp.CFrame = originalCFrame
                    end
                    
                    task.wait(farmDelay)
                end
            end
        end
    end
end

-- UI Controls
MainTab:Section({ Title = "Multi Filters (คั่นด้วยเครื่องหมาย ,)" })

MainTab:Input({
    Title = "Filter Item Names (ใส่หลายชื่อได้)",
    Desc = "ตัวอย่าง: Eye of Stone, Staff Gem, Sword",
    Placeholder = "เช่น Eye of Stone, Staff Gem",
    ClearTextOnFocus = false,
    Callback = function(text)
        targetItemNames = parseInputList(text)
    end
})

MainTab:Input({
    Title = "Filter Rarities (ใส่หลาย Rarity ได้)",
    Desc = "ตัวอย่าง: Ancient, Mythic, Legendary",
    Placeholder = "เช่น Ancient, Mythic",
    ClearTextOnFocus = false,
    Callback = function(text)
        targetRarities = parseInputList(text)
    end
})

MainTab:Section({ Title = "Auto Loop Farm Controls" })

MainTab:Toggle({
    Title = "Auto Farm & Return to Start",
    Desc = "วนลูปวาร์ปเก็บไอเทมที่ตรงเงื่อนไข แล้ววาร์ปกลับจุดเดิมทันที",
    Default = false,
    Callback = function(state)
        autoLoopFarmDrops = state
        if autoLoopFarmDrops then
            WindUI:Notify({ Title = "Auto Farm", Content = "Started Farm Loop!", Duration = 2 })
            task.spawn(function()
                while autoLoopFarmDrops do
                    collectAllDrops()
                    task.wait(0.5)
                end
            end)
        else
            WindUI:Notify({ Title = "Auto Farm", Content = "Stopped Farm Loop!", Duration = 2 })
        end
    end
})

MainTab:Slider({
    Title = "Farm Delay Speed",
    Desc = "ระยะเวลาหน่วงระหว่างการเก็บแต่ละชิ้น (วินาที)",
    Min = 0.05,
    Max = 2.0,
    Default = 0.2,
    Step = 0.05,
    Callback = function(val)
        farmDelay = val
    end
})

WindUI:Notify({
    Title = "Drops Filter V3 Loaded",
    Content = "Multi-filter & Return Position Ready!",
    Duration = 3
})
