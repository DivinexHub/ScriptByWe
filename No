local function SaveConfig()
    local configData = {
        SelectedRarities = selectedRarities,
        SelectedItemNames = selectedItemNames,
        FarmDelay = farmDelay,
        NoclipEnabled = noclipEnabled,
        WebhookUrl = discordWebhookUrl,
        SelectedStage = selectedStage,
        AutoReturnEnabled = autoReturnEnabled
    }

    local success, err = pcall(function()
        local jsonString = HttpService:JSONEncode(configData)
        if writefile then
            writefile(CONFIG_FILE_NAME, jsonString)
        end
    end)

    if success then
        WindUI:Notify({ Title = "Config Saved", Content = "บันทึกการตั้งค่าลงไฟล์เรียบร้อยแล้ว!", Duration = 3 })
    else
        WindUI:Notify({ Title = "Config Error", Content = "เกิดข้อผิดพลาดในการบันทึก: " .. tostring(err), Duration = 3 })
    end
end

local function LoadConfig()
    if not isfile or not isfile(CONFIG_FILE_NAME) then
        return
    end

    local success, err = pcall(function()
        local fileContent = readfile(CONFIG_FILE_NAME)
        local configData = HttpService:JSONEncode(fileContent)

        if configData then
            if configData.SelectedRarities then
                selectedRarities = configData.SelectedRarities
                if RarityDropdown.SetValues then RarityDropdown:SetValues(selectedRarities) end
            end

            if configData.SelectedItemNames then
                selectedItemNames = configData.SelectedItemNames
                if NameDropdown.SetValues then NameDropdown:SetValues(selectedItemNames) end
            end

            if configData.FarmDelay then
                farmDelay = configData.FarmDelay
                if DelaySlider.Set then DelaySlider:Set(farmDelay) end
            end

            if configData.NoclipEnabled ~= nil then
                noclipEnabled = configData.NoclipEnabled
                if NoclipToggle.Set then NoclipToggle:Set(noclipEnabled) end
            end

            if configData.WebhookUrl then
                discordWebhookUrl = configData.WebhookUrl
                if WebhookInput.Set then WebhookInput:Set(discordWebhookUrl) end
            end

            if configData.SelectedStage then
                selectedStage = configData.SelectedStage
                if StageDropdown.Set then StageDropdown:Set("Stage " .. tostring(selectedStage)) end
            end

            if configData.AutoReturnEnabled ~= nil then
                autoReturnEnabled = configData.AutoReturnEnabled
            end
        end
    end)

    if success then
        WindUI:Notify({ Title = "Config Loaded", Content = "โหลดการตั้งค่าเดิมสำเร็จ!", Duration = 3 })
    end
end

