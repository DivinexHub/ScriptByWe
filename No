    end

    local embedData = {
        title = config.Title,
        description = descriptionText,
        color = config.Color,
        fields = {
            {
                name = "📦 ไอเทมที่ได้",
                value = string.format("```yaml\n%s\n```", itemName ~= "" and itemName or "Unknown Item"),
                inline = true
            },
            {
                name = "💎 ความแรร์ (Rarity)",
                value = string.format("```fix\n%s\n```", itemRarity ~= "" and itemRarity or "Unknown"),
                inline = true
            },
            {
                name = "🌐 Ping",
                value = string.format("`%d ms`", pingMs),
                inline = true
            },
            {
                name = "👤 ผู้เล่น (Player)",
                value = string.format("[%s](https://www.roblox.com/users/%d/profile)", LocalPlayer.Name, LocalPlayer.UserId),
                inline = true
            },
            {
                name = "🎮 Job ID (Server)",
                value = string.format("```lua\ngame.JobId = \"%s\"\n```", game.JobId),
                inline = false
            }
        },
        footer = {
            text = "Monhub V17 • Automatic Prompt Sniper",
            icon_url = "https://i.imgur.com/8QZ8G3M.png"
        },
        timestamp = DateTime.now():ToIsoDate()
    }

    if isAstral and config.Gif then
        embedData.image = {
            url = config.Gif
