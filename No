MainTab:Toggle({
    Title = "Auto Farm & Return to Start",
    Desc = "วนลูปวาร์ปเก็บไอเทมที่ตรงเงื่อนไข แล้ววาร์ปกลับจุดเดิมทันที",
    Default = false,
    Callback = function(state)
