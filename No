    local payload = {
        username = isAstral and "🌌 Monhub | Astral Detector" or "🤖 Monhub | Loot Notifier",
        avatar_url = "https://i.imgur.com/8QZ8G3M.png",
        content = (config.Ping ~= "" and config.Ping) or nil,
        embeds = { embedData }
