MainTab:Section({ Title = "Rarity & Item Name Selection" })

MainTab:Dropdown({
    Title = "Select Rarities (เลือก Rarity)",
    Desc = "เลือก Rarity ที่ต้องการเก็บ",
    Values = {
        "Common", "Uncommon", "Rare", "Epic",
        "Legend", "Mythical", "Secret", "Ancient", "Supreme"
    },
    Multi = true,
    Default = {},
    Callback = function(values)
        selectedRarities = values or {}
    end
})

local NameDropdown = MainTab:Dropdown({
    Title = "Select Item Names (เลือกชื่อของ)",
    Desc = "เลือกชื่อไอเทมที่พบในแมป",
    Values = {},
    Multi = true,
    Default = {},
    Callback = function(values)
        selectedItemNames = values or {}
    end
})

local function updateDropdownOptions(dropdown, newValues)
    if not dropdown then return end
    if dropdown.SetValues then
        dropdown:SetValues(newValues)
    elseif dropdown.Refresh then
        dropdown:Refresh(newValues)
    elseif dropdown.Update then
        dropdown:Update(newValues)
    elseif dropdown.Values then
        dropdown.Values = newValues
    end
end

local function scanItemNames()
    local dropsClientFolder = Workspace:FindFirstChild("DropsClient")
    if not dropsClientFolder then return end

    local foundNameMap = {}
    local newNames = {}

    for _, childFolder in ipairs(dropsClientFolder:GetChildren()) do
        for _, dropItemFolder in ipairs(childFolder:GetChildren()) do
            local itemName, _ = getItemDetails(dropItemFolder)
            if itemName ~= "" and not foundNameMap[itemName] then
                foundNameMap[itemName] = true
                table.insert(newNames, itemName)
            end
        end
    end

    scannedNames = newNames
    if #scannedNames > 0 then
        updateDropdownOptions(NameDropdown, scannedNames)
    end
end

MainTab:Button({
    Title = "Scan Map Item Names",
    Callback = function()
        task.spawn(function()
            scanItemNames()
            WindUI:Notify({ Title = "Scan Complete", Content = "Updated item names dropdown!", Duration = 3 })
        end)
    end
})

local function checkCanCollect(itemName, itemRarity)
    local hasNameFilter = #selectedItemNames > 0
    local hasRarityFilter = #selectedRarities > 0

    if not hasNameFilter and not hasRarityFilter then
        return true
    end

    local nameMatched = false
    local rarityMatched = false

    if hasNameFilter then
        for _, name in ipairs(selectedItemNames) do
            if string.find(string.lower(itemName), string.lower(name), 1, true) then
                nameMatched = true
                break
            end
        end
    end

    if hasRarityFilter then
        for _, rarity in ipairs(selectedRarities) do
            if string.find(string.lower(itemRarity), string.lower(rarity), 1, true) then
                rarityMatched = true
                break
            end
        end
    end

    return rarityMatched or nameMatched
end

local function collectAllDrops()
    local dropsClientFolder = Workspace:FindFirstChild("DropsClient")
    if not dropsClientFolder then return end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local originalCFrame = hrp and hrp.CFrame

    for _, childFolder in ipairs(dropsClientFolder:GetChildren()) do
        if not autoLoopFarmDrops then break end
        
        for _, dropItemFolder in ipairs(childFolder:GetChildren()) do
            if not autoLoopFarmDrops then break end
            
            local itemName, itemRarity = getItemDetails(dropItemFolder)

            if checkCanCollect(itemName, itemRarity) then
                local targetCFrame = getObjectCFrame(dropItemFolder)
                
                if hrp and targetCFrame then
                    hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                    task.wait(0.1)
                    
                    triggerPromptsIn(dropItemFolder)
                    holdE(0.8)
                    
                    -- ส่ง Webhook
                    sendWebhookNotification(itemName, itemRarity)

                    if originalCFrame then
                        hrp.CFrame = originalCFrame
                    end
                    
                    task.wait(farmDelay)
                end
            end
        end
    end
end

MainTab:Section({ Title = "Auto Farm Controls" })

MainTab:Toggle({
    Title = "Auto Farm Selected Items",
    Default = false,
    Callback = function(state)
        autoLoopFarmDrops = state
        if autoLoopFarmDrops then
            WindUI:Notify({ Title = "Auto Farm", Content = "Started Farm Loop!", Duration = 2 })
            task.spawn(function()
                while autoLoopFarmDrops do
                    collectAllDrops()
                    task.wait(0.5)
                end
            end)
        else
            WindUI:Notify({ Title = "Auto Farm", Content = "Stopped Farm Loop!", Duration = 2 })
        end
    end
})

MainTab:Slider({
