-- Helper Functions
local function holdE(duration)
    task.spawn(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(duration or 0.8)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

-- PROMPT SNIPING: ดึง Prompt มาที่ตัวเราชั่วคราวเพื่อยิงกด โดยไม่ต้องวาร์ป
local function triggerPromptWithoutTP(parentObj)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp or not parentObj then return end

    for _, child in ipairs(parentObj:GetDescendants()) do
        if child:IsA("ProximityPrompt") then
            local originalParent = child.Parent
            local originalDistance = child.MaxActivationDistance
            local originalLineOfSight = child.RequiresLineOfSight

            -- ปรับแต่ง Prompt ให้กดง่าย
            child.RequiresLineOfSight = false
            child.MaxActivationDistance = 999999
            child.Parent = hrp -- ดึงมาแปะไว้ที่ HumanoidRootPart ของตัวเรา

            task.wait(0.02)
            fireproximityprompt(child)
            holdE(0.3)
            task.wait(0.02)

            -- คืนค่าเดิม
            child.MaxActivationDistance = originalDistance
            child.RequiresLineOfSight = originalLineOfSight
            child.Parent = originalParent
        end
    end
end

local function getItemDetails(dropItemFolder)
    local root = dropItemFolder:FindFirstChild("Root")
    if not root then return "", "" end

    local dropUI = root:FindFirstChild("Drop")
    if not dropUI then return "", "" end

    local xyd = dropUI:FindFirstChild("XYD")
    local zhName = dropUI:FindFirstChild("ZhName")

    local rarity = xyd and (xyd:IsA("TextLabel") or xyd:IsA("TextBox")) and xyd.Text or ""
    local name = zhName and (zhName:IsA("TextLabel") or zhName:IsA("TextBox")) and zhName.Text or ""

    return name, rarity
end

-- Discord Webhook Sender
local function sendWebhookNotification(itemName, itemRarity)
    if discordWebhookUrl == "" or not string.find(discordWebhookUrl, "http") then return end

    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not requestFunc then return end

    local payload = {
        embeds = {{
            title = "🎁 Item Collected!",
            color = 65280,
            fields = {
                { name = "Player", value = LocalPlayer.Name, inline = true },
                { name = "Item Name", value = itemName ~= "" and itemName or "Unknown", inline = true },
                { name = "Rarity", value = itemRarity ~= "" and itemRarity or "Unknown", inline = true }
            },
            timestamp = DateTime.now():ToIsoDate()
        }}
    }

    task.spawn(function()
        pcall(function()
            requestFunc({
                Url = discordWebhookUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end)
end

-- Noclip Logic
local function toggleNoclip(state)
    noclipEnabled = state
    if noclipEnabled then
        noclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function updateDropdownOptions(dropdownObj, newValues)
    if not dropdownObj then return end
    pcall(function()
        if dropdownObj.SetValues then
            dropdownObj:SetValues(newValues)
        elseif dropdownObj.Refresh then
            dropdownObj:Refresh(newValues)
        elseif dropdownObj.Update then
            dropdownObj:Update(newValues)
        elseif dropdownObj.Values then
            dropdownObj.Values = newValues
        end
    end)
end

