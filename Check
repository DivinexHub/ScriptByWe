local function buildTxtDump()
    if not dumpData then return "No dump data." end
    local lines = {}
    local function push(s) table.insert(lines, s) end

    push("=== DIVINEX FULL EXPLORER DUMP ===")
    push(string.format("Player:    %s (UserId: %d)", dumpData.meta.player, dumpData.meta.userId))
    push(string.format("PlaceId:   %s | JobId: %s", dumpData.meta.placeId, dumpData.meta.jobId))
    push(string.format("Timestamp: %s", dumpData.meta.timestamp))
    push(string.rep("=", 60))

    push(string.format("\n[ REMOTES — %d total ]",
        #dumpData.allRemotes.events + #dumpData.allRemotes.functions +
        #dumpData.allRemotes.bindableEvents + #dumpData.allRemotes.bindableFunctions))
    push("-- RemoteEvents --")
    for _, v in dumpData.allRemotes.events do push("  " .. v) end
    push("-- RemoteFunctions --")
    for _, v in dumpData.allRemotes.functions do push("  " .. v) end
    push("-- BindableEvents --")
    for _, v in dumpData.allRemotes.bindableEvents do push("  " .. v) end
    push("-- BindableFunctions --")
    for _, v in dumpData.allRemotes.bindableFunctions do push("  " .. v) end

    push(string.format("\n[ SCRIPTS/MODULES — %d total ]", #dumpData.allScripts))
    for _, v in dumpData.allScripts do push(string.format("  [%s] %s", v.class, v.path)) end

    push(string.format("\n[ PROXIMITY PROMPTS — %d total ]", #dumpData.allPrompts))
    for _, v in dumpData.allPrompts do
        push(string.format("  %s  (Action: '%s', Hold: %ss)", v.path, v.action, tostring(v.hold)))
    end

    push(string.format("\n[ CLICK DETECTORS — %d total ]", #dumpData.allClickDetectors))
    for _, v in dumpData.allClickDetectors do push("  " .. v) end

    push("\n" .. string.rep("=", 60))
    push("[ FULL SERVICE TREE ]")

    -- Recursive tree printer
    local function printTree(node, indent)
        indent = indent or ""
        if not node or not node.name then return end
        local propStr = ""
        if node.props then
            local parts = {}
            for k, v in node.props do
                if k ~= "ClassName" and k ~= "Name" then
                    table.insert(parts, string.format("%s=%s", k, v))
                end
            end
            if #parts > 0 then propStr = "  { " .. table.concat(parts, ", ") .. " }" end
        end
        push(string.format("%s[%s] %s%s", indent, node.class or "?", node.name or "?", propStr))
        if node.children then
            for _, child in node.children do
                printTree(child, indent .. "  ")
            end
        end
    end

    for svcName, svcData in dumpData.services do
        push(string.format("\n=== %s ===", svcName))
        if svcData.accessible == false then
            push("  (not accessible)")
        else
            printTree(svcData, "  ")
        end
    end

    push("\n" .. string.rep("=", 60))
    push("END OF DUMP")
    return table.concat(lines, "\n")
end

local function doExport(format)
    if not dumpData then
        WindUI:Notify({ Title = "No Data", Content = "Run a dump first!", Duration = 3, Icon = "alert-circle" })
        return
    end

    local fname = string.format("ExplorerDump_%s_%s.%s", LocalPlayer.Name, tostring(os.time()), format)
    local content

    if format == "json" then
        local ok, enc = pcall(function() return HttpService:JSONEncode(dumpData) end)
        content = ok and enc or buildTxtDump()
    else
        content = buildTxtDump()
    end

    local path = "DivinexDump/" .. fname

    if writefile then
        if makefolder then pcall(function() makefolder("DivinexDump") end) end
        local ok, err = pcall(function() writefile(path, content) end)
        if ok then
            setStatus(exportPara, string.format("✅ Saved!\nPath: %s\nSize: %d KB", path, math.floor(#content / 1024)))
            WindUI:Notify({ Title = "Exported! 📄", Content = fname, Duration = 5, Icon = "download" })
        else
            setStatus(exportPara, "❌ writefile failed: " .. tostring(err))
        end
    elseif setclipboard then
        -- Clip first 500k chars if too large for clipboard
        local clip = #content > 500000 and content:sub(1, 500000) .. "\n...[TRUNCATED]" or content
        setclipboard(clip)
        setStatus(exportPara, "⚠️ writefile not available\nCopied to clipboard! (" .. math.floor(#content/1024) .. " KB)")
        WindUI:Notify({ Title = "Copied! 📋", Content = "writefile() unavailable — clipboard used", Duration = 4, Icon = "clipboard" })
    else
        setStatus(exportPara, "❌ No export method available (writefile & setclipboard both missing)")
    end
end

