local function setStatus(para, msg)
    pcall(function() if para then para:SetDesc(msg) end end)
end

local function getProps(obj)
    local props = {}

    -- ClassName always available
    props.ClassName = obj.ClassName

    -- Name
    local okN, name = pcall(function() return obj.Name end)
    if okN then props.Name = name end

    -- Common props by class
    local function tryAdd(key, fn)
        local ok, v = pcall(fn)
        if ok and v ~= nil then
            props[key] = tostring(v)
        end
    end

    if obj:IsA("BasePart") then
        tryAdd("Size",     function() return tostring(obj.Size) end)
        tryAdd("Position", function() return tostring(obj.Position) end)
        tryAdd("Anchored", function() return obj.Anchored end)
        tryAdd("CanCollide", function() return obj.CanCollide end)

    elseif obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
        props.FullPath = obj:GetFullName()

    elseif obj:IsA("ModuleScript") or obj:IsA("LocalScript") or obj:IsA("Script") then
        props.FullPath = obj:GetFullName()
        tryAdd("Disabled", function() return obj.Disabled end)

    elseif obj:IsA("StringValue") or obj:IsA("IntValue") or obj:IsA("BoolValue") or obj:IsA("NumberValue") then
        tryAdd("Value", function() return obj.Value end)

    elseif obj:IsA("ProximityPrompt") then
        tryAdd("ActionText",  function() return obj.ActionText end)
        tryAdd("ObjectText",  function() return obj.ObjectText end)
        tryAdd("HoldDuration",function() return obj.HoldDuration end)
        tryAdd("Enabled",     function() return obj.Enabled end)

    elseif obj:IsA("ClickDetector") then
        tryAdd("MaxActivationDistance", function() return obj.MaxActivationDistance end)

    elseif obj:IsA("Model") then
        tryAdd("PrimaryPart", function() return obj.PrimaryPart and obj.PrimaryPart.Name or "nil" end)

    elseif obj:IsA("Humanoid") then
        tryAdd("Health",    function() return obj.Health end)
        tryAdd("MaxHealth", function() return obj.MaxHealth end)
        tryAdd("WalkSpeed", function() return obj.WalkSpeed end)

    elseif obj:IsA("Animation") then
        tryAdd("AnimationId", function() return obj.AnimationId end)

    elseif obj:IsA("Sound") then
        tryAdd("SoundId",  function() return obj.SoundId end)
        tryAdd("Volume",   function() return obj.Volume end)
        tryAdd("Playing",  function() return obj.IsPlaying end)

    elseif obj:IsA("BillboardGui") or obj:IsA("ScreenGui") or obj:IsA("SurfaceGui") then
        tryAdd("Enabled",   function() return obj.Enabled end)
        tryAdd("FullPath",  function() return obj:GetFullName() end)

    elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
        tryAdd("Text",      function() return obj.Text end)
        tryAdd("Visible",   function() return obj.Visible end)

    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        tryAdd("Image",   function() return obj.Image end)
        tryAdd("Visible", function() return obj.Visible end)

    elseif obj:IsA("Folder") then
        props.ChildCount = tostring(#obj:GetChildren())

    elseif obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
        props.FullPath = obj:GetFullName()
    end

    return props
end

-- Recursive tree builder
local function buildTree(obj, maxDepth, currentDepth, remotes, scripts, prompts, clickDetectors)
    currentDepth = currentDepth or 0
    if currentDepth > (maxDepth or 20) then return { _truncated = true } end

    local node = {
        name      = obj.Name,
        class     = obj.ClassName,
        path      = obj:GetFullName(),
        props     = getProps(obj),
        children  = {},
    }

    -- Collect special objects
    if obj:IsA("RemoteEvent") then
        table.insert(remotes.events, obj:GetFullName())
    elseif obj:IsA("RemoteFunction") then
        table.insert(remotes.functions, obj:GetFullName())
    elseif obj:IsA("BindableEvent") then
        table.insert(remotes.bindableEvents, obj:GetFullName())
    elseif obj:IsA("BindableFunction") then
        table.insert(remotes.bindableFunctions, obj:GetFullName())
    elseif obj:IsA("LocalScript") or obj:IsA("Script") or obj:IsA("ModuleScript") then
        table.insert(scripts, { path = obj:GetFullName(), class = obj.ClassName })
    elseif obj:IsA("ProximityPrompt") then
        local ok, info = pcall(function()
            return { path = obj:GetFullName(), action = obj.ActionText, hold = obj.HoldDuration }
        end)
        if ok then table.insert(prompts, info) end
    elseif obj:IsA("ClickDetector") then
        table.insert(clickDetectors, obj:GetFullName())
    end

    -- Recurse children
    local ok, children = pcall(function() return obj:GetChildren() end)
    if ok and children then
        for _, child in children do
            local ok2, childNode = pcall(buildTree, child, maxDepth, currentDepth + 1, remotes, scripts, prompts, clickDetectors)
            if ok2 and childNode then
                table.insert(node.children, childNode)
            end
        end
    end

    return node
end

-- ========================
-- Main Dump Function
-- ========================
local function runDump()
    if isDumping then return end
    isDumping = true

    local result = {
        meta = {
            player    = LocalPlayer.Name,
            userId    = LocalPlayer.UserId,
            placeId   = tostring(game.PlaceId),
            jobId     = game.JobId,
            timestamp = tostring(os.time()),
        },
        services    = {},
        allRemotes  = { events = {}, functions = {}, bindableEvents = {}, bindableFunctions = {} },
        allScripts  = {},
        allPrompts  = {},
        allClickDetectors = {},
    }

    local total    = #SERVICE_NAMES
    local scanned  = 0
    local failed   = 0

    for _, svcName in SERVICE_NAMES do
        scanned += 1
        setStatus(statusPara, string.format("⏳ [%d/%d] Scanning: %s", scanned, total, svcName))
        setStatus(progressPara, string.format("Progress: %d%% | ✅ %d | ❌ %d",
            math.floor(scanned / total * 100), scanned - failed, failed))
        task.wait(0.05)

        local ok, svc = pcall(game.GetService, game, svcName)
        if not ok or not svc then
            failed += 1
            result.services[svcName] = { accessible = false }
            continue
        end

        local ok2, tree = pcall(buildTree, svc, 15, 0,
            result.allRemotes, result.allScripts, result.allPrompts, result.allClickDetectors)

        if ok2 and tree then
            tree.accessible = true
            result.services[svcName] = tree
        else
            failed += 1
            result.services[svcName] = { accessible = false, error = tostring(tree) }
        end
    end

    dumpData = result
    isDumping = false

    local remoteCount =
        #result.allRemotes.events +
        #result.allRemotes.functions +
        #result.allRemotes.bindableEvents +
        #result.allRemotes.bindableFunctions

    setStatus(statusPara, string.format(
        "✅ Dump complete!\nServices: %d scanned, %d failed\nRemotes found: %d\nScripts found: %d\nProximityPrompts: %d\nClickDetectors: %d",
        scanned, failed, remoteCount, #result.allScripts, #result.allPrompts, #result.allClickDetectors
    ))
    setStatus(progressPara, "Done! Go to Remotes or Export tab.")

    -- Update remote tab
    local lines = {
        string.format("RemoteEvents:      %d", #result.allRemotes.events),
        string.format("RemoteFunctions:   %d", #result.allRemotes.functions),
        string.format("BindableEvents:    %d", #result.allRemotes.bindableEvents),
        string.format("BindableFunctions: %d", #result.allRemotes.bindableFunctions),
        "", "=== RemoteEvents ===",
    }
    for _, v in result.allRemotes.events do table.insert(lines, "  • " .. v) end
    table.insert(lines, "\n=== RemoteFunctions ===")
    for _, v in result.allRemotes.functions do table.insert(lines, "  • " .. v) end
    table.insert(lines, "\n=== BindableEvents ===")
    for _, v in result.allRemotes.bindableEvents do table.insert(lines, "  • " .. v) end
    table.insert(lines, "\n=== BindableFunctions ===")
    for _, v in result.allRemotes.bindableFunctions do table.insert(lines, "  • " .. v) end
    table.insert(lines, "\n=== Scripts/Modules ===")
    for _, v in result.allScripts do table.insert(lines, string.format("  [%s] %s", v.class, v.path)) end
    table.insert(lines, "\n=== ProximityPrompts ===")
    for _, v in result.allPrompts do
        table.insert(lines, string.format("  • %s (Action: %s, Hold: %ss)", v.path, v.action, tostring(v.hold)))
    end
    table.insert(lines, "\n=== ClickDetectors ===")
    for _, v in result.allClickDetectors do table.insert(lines, "  • " .. v) end

    setStatus(remotePara, table.concat(lines, "\n"))

    WindUI:Notify({
        Title   = "Dump Complete ✅",
        Content = string.format("%d services | %d remotes | %d scripts", scanned, remoteCount, #result.allScripts),
        Duration = 5, Icon = "database",
    })
end

