-- 4. Auto Click Fast (จำลองคลิกหน้าจอ + ดักจับ Remote Spy ก่อนเริ่ม Loop)
MainTab:Toggle({
    Title = "Auto Click Fast",
    Callback = function(Value)
        States.AutoClickFast = Value
        if Value then
            task.spawn(function()
                -- 1. จำลองการคลิกหน้าจอด้วย VirtualUser เพื่อส่ง Remote M1 ออกไป
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(0, 0))
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(0, 0))
                
                -- 2. ดักดึงค่าชื่อยูนิต
                local charName = getEquippedCharacterName()
                
                if not charName then
                    warn("[Auto Click Fast] ไม่สามารถตรวจจับชื่อยูนิตจากระบบได้ กรุณาลองเปิดใหม่อีกครั้ง")
                    return
                end

                -- 3. เริ่มรันยิง Remote ตามชื่อที่ตรวจจับได้
                while States.AutoClickFast do
                    fireRemote("combat/m1", { charName, 1 })
                    task.wait(LOOP_DELAY)
                end
            end)
        end
    end
})

