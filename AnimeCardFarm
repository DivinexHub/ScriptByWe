-- TAB 2: GRADE F > UR
-- ==========================================
GradeTab:Section({ Title = "Card & Grade Selection" })

local InitialCards = GetCardList()

local CardDropdown = GradeTab:Dropdown({
    Title = "Select Card For Grade",
    Desc = "Select card from Backpack/Character to roll grade.",
    Values = InitialCards,
    Value = InitialCards[1] or nil,
    Callback = function(Option)
        SelectedCardForGrade = Option
    end
})

SelectedCardForGrade = InitialCards[1] ~= "None" and InitialCards[1] or nil

GradeTab:Button({
    Title = "Refresh Card List",
    Desc = "Update list of available cards from Backpack.",
    Callback = function()
        local updatedCards = GetCardList()
        CardDropdown:SetValues(updatedCards)
        
        if #updatedCards > 0 and updatedCards[1] ~= "None" then
            SelectedCardForGrade = updatedCards[1]
            CardDropdown:SetValue(updatedCards[1])
        end

        WindUI:Notify({
            Title = "Refreshed",
            Content = "Card list updated successfully!",
            Duration = 2
        })
    end
})

GradeTab:Dropdown({
    Title = "Select Target Grades (Smart Filter)",
    Desc = "Multi-select target grades. Auto Roll stops if target or HIGHER grade is reached.",
    Values = GradeList,
    Multi = true,
    Value = {"UR"},
    Callback = function(Options)
        SelectedTargetGrades = {}
        if type(Options) == "table" then
            for _, g in pairs(Options) do
                SelectedTargetGrades[g] = true
            end
        elseif type(Options) == "string" then
            SelectedTargetGrades[Options] = true
        end
    end
})

-- Initial Default Grade Setup
SelectedTargetGrades["UR"] = true

GradeTab:Section({ Title = "Auto Roll Grade Control" })

local GradeToggle
GradeToggle = GradeTab:Toggle({
    Title = "Auto Roll Grade",
    Desc = "Rolls card grade automatically until target (or higher) grade is acquired.",
    Value = false,
    Callback = function(Value)
        AutoGradeEnabled = Value

        if AutoGradeEnabled then
            task.spawn(function()
                local GradeRollRE = ReplicatedStorage:FindFirstChild("Remotes") 
                    and ReplicatedStorage.Remotes:FindFirstChild("GradeRollRE")

                while AutoGradeEnabled do
                    if not SelectedCardForGrade or SelectedCardForGrade == "" or SelectedCardForGrade == "None" then
                        WindUI:Notify({ Title = "Warning", Content = "Please select a valid card first!", Duration = 3 })
                        AutoGradeEnabled = false
                        GradeToggle:SetValue(false)
                        break
                    end

                    local toolObj = LocalPlayer.Backpack:FindFirstChild(SelectedCardForGrade) 
                        or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(SelectedCardForGrade))

                    if not toolObj then
                        WindUI:Notify({ Title = "Error", Content = "Selected card not found in Backpack or Character!", Duration = 3 })
                        AutoGradeEnabled = false
                        GradeToggle:SetValue(false)
                        break
                    end

                    -- Smart Grade Check (Stops on target OR higher grade)
                    local isSuccess, currentGrade = CheckSmartGrade(SelectedCardForGrade)
                    if isSuccess then
                        WindUI:Notify({ 
                            Title = "Smart Stop Triggered!", 
                            Content = "Acquired Grade: " .. tostring(currentGrade) .. " on " .. tostring(SelectedCardForGrade), 
                            Duration = 5 
                        })
                        AutoGradeEnabled = false
                        GradeToggle:SetValue(false)
                        break
                    end

                    -- Fire RemoteEvent to Roll Grade
                    if GradeRollRE then
                        GradeRollRE:FireServer("RollGrade", {
                            Tool = toolObj,
                            Currency = "Cash"
                        })
                    end

                    task.wait(0.1)
                end
            end)
        end
    end
})
