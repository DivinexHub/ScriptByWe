        elseif type(opts) == "string" then
            SelectedMutations[opts] = true
        end
    end,
})

FarmTab:Toggle({
    Title = "Auto Buy Packs",
    Desc  = "Fires ProximityPrompts on conveyor packs rapidly",
    Flag  = "autoBuy",
    Callback = function(v)
        AutoBuyEnabled = v
        if not v then return end
        task.spawn(function()
            while AutoBuyEnabled do
                for _, plot in pairs(GetAllPlots()) do
                    local n0       = plot:FindFirstChild("Plot_N0")
                    local conveyor = n0 and n0:FindFirstChild("LocalConveyorModels")
                    if conveyor then
                        for _, pack in pairs(conveyor:GetChildren()) do
                            if IsPackSelected(pack.Name) and HasTargetMutation(pack) then
                                local prompt = pack:FindFirstChild("Main")
                                    and pack.Main:FindFirstChildOfClass("ProximityPrompt")
                                if prompt then
                                    pcall(fireproximityprompt, prompt, 0)
                                    pcall(fireproximityprompt, prompt)
                                end
                            end
                        end
                    end
                end
                task.wait(0.01)
            end
        end)
    end,
})

