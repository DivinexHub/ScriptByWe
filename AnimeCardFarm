-- State
-- ========================
local AutoRollEnabled      = false
local AutoBuyEnabled       = false
local SelectedPacks        = { ["All"] = true }
local RollDelay            = 0.2
local AutoGradeEnabled     = false
local SelectedCardForGrade = nil
local SelectedTargetGrades = { ["UR"] = true }
local SelectedMutations    = {}
local WebhookURL           = ""
local WebhookEnabled       = false

-- ========================
-- Constants
-- ========================
local MutationList = {
    "Normal","Golden","Diamond","Venomous","Rainbow",
    "Sakura","Candy","Blessed","Radioactive","Glitch","Starfallen","Admin"
}
local GradeList = {"F","E","D","C","B","A","S","SS","SR","UR"}
local GradeRank = {F=1,E=2,D=3,C=4,B=5,A=6,S=7,SS=8,SR=9,UR=10}

local PackList = {"All"}
pcall(function()
    for _, p in pairs(ReplicatedStorage.Models.Packs:GetChildren()) do
        table.insert(PackList, p.Name)
    end
end)

-- ========================
-- Helpers
-- ========================
local function GetAllPlots()
    local plots = {}
    pcall(function()
        for _, plot in pairs(workspace.MAP.Plots:GetChildren()) do
            if plot:FindFirstChild("Plot_N0") then
                table.insert(plots, plot)
            end
        end
    end)
    return plots
end

local function HasTargetMutation(packModel)
    local count = 0
    for _ in pairs(SelectedMutations) do count += 1 end
    if count == 0 then return true end
    local ok, mutFolder = pcall(function()
        return packModel.GuiHolder.BillboardGuiInfo.Mutation
    end)
    if not ok or not mutFolder then return false end
    for name, on in pairs(SelectedMutations) do
        if on then
            local child = mutFolder:FindFirstChild(name)
            if child then
                if child:IsA("GuiObject") and child.Visible then return true end
                if not child:IsA("GuiObject") then return true end
            end
        end
    end
    return false
end

local function IsPackSelected(packName)
    if SelectedPacks["All"] then return true end
    return SelectedPacks[packName] == true
end

-- FIX: Safe card list that always returns a valid table
local function GetCardList()
    local cards, seen = {}, {}
    pcall(function()
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item:IsA("Tool") and not seen[item.Name] then
                seen[item.Name] = true
                table.insert(cards, item.Name)
            end
        end
    end)
    pcall(function()
        for _, item in pairs(LocalPlayer.Character:GetChildren()) do
            if item:IsA("Tool") and not seen[item.Name] then
                seen[item.Name] = true
                table.insert(cards, item.Name)
            end
        end
    end)
    return #cards > 0 and cards or {"None"}
end

-- FIX: Refresh dropdown safely — tries both method names WindUI may expose
local function RefreshDropdown(dropdown, newValues)
    if not dropdown then return end
    -- WindUI exposes either :Refresh() or :SetValues() depending on version
    local ok1 = pcall(function() dropdown:Refresh(newValues) end)
    if not ok1 then
        pcall(function() dropdown:SetValues(newValues) end)
    end
end

local function GetBackpackItemCount(itemName)
    local count = 0
    pcall(function()
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item.Name == itemName then count += 1 end
        end
    end)
    pcall(function()
        for _, item in pairs(LocalPlayer.Character:GetChildren()) do
            if item.Name == itemName then count += 1 end
        end
    end)
    return count
end

local function SendWebhook(itemName, quantity)
    if not WebhookEnabled or WebhookURL == "" then return end
    local httpRequest = (syn and syn.request)
        or (http and http.request)
        or http_request or request
    if not httpRequest then return end
    local payload = HttpService:JSONEncode({
        username = "Divinex Notifier",
        embeds = {{
            title  = "🛒 Item Purchased!",
            color  = 65280,
            fields = {
                { name = "Player",    value = LocalPlayer.Name,   inline = true },
                { name = "Item",      value = itemName,            inline = true },
                { name = "Qty",       value = tostring(quantity),  inline = true },
            },
            timestamp = DateTime.now():ToIsoDate()
        }}
    })
    pcall(function()
        httpRequest({
            Url     = WebhookURL,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = payload,
        })
    end)
end

local function CheckSmartGrade(cardName)
    local card = (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild(cardName))
        or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(cardName))
    if not card then return false, nil end
    local ok, gradeFolder = pcall(function()
        return card.CardHolder.SurfaceGuiBack.Grade
    end)
    if not ok or not gradeFolder then return false, nil end
    local curName, curRank = nil, 0
    for _, gName in ipairs(GradeList) do
        local obj = gradeFolder:FindFirstChild(gName)
        if obj then
            local vis = obj:IsA("GuiObject") and obj.Visible or (not obj:IsA("GuiObject"))
            if vis then curName = gName curRank = GradeRank[gName] or 0 break end
        end
    end
    if not curName then return false, nil end
    local minRank, hasTarget = 999, false
    for gName, on in pairs(SelectedTargetGrades) do
        if on and GradeRank[gName] then
            hasTarget = true
            if GradeRank[gName] < minRank then minRank = GradeRank[gName] end
        end
    end
    if not hasTarget then return true, curName end
    return curRank >= minRank, curName
end

-- Webhook monitor
task.spawn(function()
    local bp = LocalPlayer:WaitForChild("Backpack", 10)
    if not bp then return end
    bp.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and AutoBuyEnabled then
            task.wait(0.2)
            SendWebhook(child.Name, GetBackpackItemCount(child.Name))
        end
    end)
end)

