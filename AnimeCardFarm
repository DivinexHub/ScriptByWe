})
SelectedCardForGrade = initialCards[1] ~= "None" and initialCards[1] or nil

-- FIX: Refresh Card List now uses safe RefreshDropdown helper with dual method fallback
GradeTab:Button({
    Title = "Refresh Card List",
    Desc  = "Re-scan Backpack and Character for latest cards",
    Icon  = "refresh-cw",
    Callback = function()
        local cards = GetCardList()

        -- Safely refresh the dropdown regardless of which method WindUI exposes
        RefreshDropdown(CardDropdown, cards)

        -- Update selection to first valid card
        if cards[1] and cards[1] ~= "None" then
            SelectedCardForGrade = cards[1]
            -- Optionally sync the dropdown's displayed value if WindUI supports it
            pcall(function() CardDropdown:SetValue(cards[1]) end)
        else
            SelectedCardForGrade = nil
        end

        WindUI:Notify({
            Title   = "Refreshed ✅",
            Content = "Found " .. #cards .. " card(s) in Backpack",
            Duration = 3,
            Icon    = "check",
        })
    end,
})

GradeTab:Dropdown({
    Title    = "Target Grades",
    Desc     = "Stops when card reaches this grade or higher",
    Values   = GradeList,
    Multi    = true,
    Flag     = "targetGrades",
    Callback = function(opts)
        SelectedTargetGrades = {}
        if type(opts) == "table" then
            for _, g in pairs(opts) do SelectedTargetGrades[g] = true end
        elseif type(opts) == "string" then
            SelectedTargetGrades[opts] = true
        end
    end,
})
SelectedTargetGrades["UR"] = true

GradeTab:Divider()
GradeTab:Section({ Title = "Auto Grade Roll" })

local GradeToggle
GradeToggle = GradeTab:Toggle({
    Title = "Auto Roll Grade",
    Desc  = "Rolls card grade until target or higher is reached",
    Flag  = "autoGrade",
    Callback = function(v)
        AutoGradeEnabled = v
        if not v then return end
        task.spawn(function()
            local GradeRollRE = nil
            pcall(function() GradeRollRE = ReplicatedStorage.Remotes.GradeRollRE end)

            while AutoGradeEnabled do
                if not SelectedCardForGrade or SelectedCardForGrade == "None" then
                    WindUI:Notify({ Title = "Warning", Content = "Select a card first!", Duration = 3, Icon = "alert-circle" })
                    AutoGradeEnabled = false
                    pcall(function() GradeToggle:SetValue(false) end)
                    break
                end

                local tool = (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild(SelectedCardForGrade))
                    or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(SelectedCardForGrade))

                if not tool then
                    WindUI:Notify({ Title = "Error", Content = SelectedCardForGrade .. " not found!", Duration = 3, Icon = "x" })
                    AutoGradeEnabled = false
                    pcall(function() GradeToggle:SetValue(false) end)
                    break
                end

                local done, grade = CheckSmartGrade(SelectedCardForGrade)
                if done then
                    WindUI:Notify({
                        Title    = "Grade Reached! ✅",
                        Content  = SelectedCardForGrade .. " → " .. tostring(grade),
                        Duration = 6,
                        Icon     = "check-circle",
                    })
                    AutoGradeEnabled = false
                    pcall(function() GradeToggle:SetValue(false) end)
                    break
                end

                if GradeRollRE then
                    pcall(function()
                        GradeRollRE:FireServer("RollGrade", { Tool = tool, Currency = "Cash" })
                    end)
                end

                task.wait(0.1)
            end
        end)
    end,
})

