-- Remote Event Checkers
local function getCodesRemote()
    local success, event = pcall(function()
        return ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Others", 5):WaitForChild("Codes", 5)
    end)
    return success and event or nil
end

local function getUpgradesRemote()
    local success, event = pcall(function()
        return ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Others", 5):WaitForChild("Upgrades", 5)
    end)
    return success and event or nil
end

