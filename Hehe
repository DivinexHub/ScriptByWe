-- 1. SECRET CODES TAB (With 2s Delay)
-- ==========================================
local CodesTab = Window:Tab({
    Title = "Secret Codes",
    Icon = "code"
})

local function redeemCode(codeText)
    if not codeText or codeText == "" then return end
    
    local Remote = getRemoteEvent()
    if Remote then
        Remote:FireServer(codeText)
        WindUI:Notify({
            Title = "Redeem Attempted",
            Content = "Fired Code: " .. tostring(codeText),
            Duration = 3
        })
    else
        WindUI:Notify({
            Title = "Error",
            Content = "RemoteEvent 'Remotes.Others.Codes' not found!",
            Duration = 4
        })
    end
end

local function scanAndRedeem()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then 
        WindUI:Notify({ Title = "Error", Content = "PlayerGui not found!", Duration = 3 })
        return 
    end

    local foundCodes = {}
    local targets = {
        playerGui:FindFirstChild("SecretCodes"),
        playerGui:FindFirstChild("SecretCodes") and playerGui.SecretCodes:FindFirstChild("Codes")
    }

    local count = 0
    for _, parentObj in ipairs(targets) do
        if parentObj then
            for _, child in ipairs(parentObj:GetChildren()) do
                local extractedCode = nil

                if child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
                    if child.Text ~= "" then extractedCode = child.Text end
                elseif child:IsA("StringValue") then
                    if child.Value ~= "" then extractedCode = child.Value end
                else
                    extractedCode = child.Name
                end

                if extractedCode and not foundCodes[extractedCode] then
                    foundCodes[extractedCode] = true
                    count = count + 1
                    redeemCode(extractedCode)
                    task.wait(2) -- Delay 2 วินาที
                end
            end
        end
    end

    if count == 0 then
        WindUI:Notify({
            Title = "Scan Complete",
            Content = "No valid codes found in SecretCodes GUI.",
            Duration = 3
        })
    else
        WindUI:Notify({
            Title = "Scan Complete",
            Content = "Scanned and executed " .. tostring(count) .. " code(s) with 2s delay!",
            Duration = 4
        })
    end
end

CodesTab:Section({ Title = "Code System Tester" })

CodesTab:Button({
    Title = "Scan & Auto-Redeem All Codes (2s Delay)",
    Desc = "Scans SecretCodes & SecretCodes.Codes folder",
    Callback = function()
        scanAndRedeem()
    end
})

CodesTab:Input({
    Title = "Manual Code Redeem",
    Desc = "Enter code directly to fire server",
    Placeholder = "Enter code here...",
    ClearTextOnFocus = false,
    Callback = function(text)
        if text and text ~= "" then
            redeemCode(text)
        end
    end
})

-- ==========================================
-- 2. COCONUT TAB (Auto Loop Teleport)
-- ==========================================
local CoconutTab = Window:Tab({
    Title = "Coconut",
    Icon = "tree-palm"
})

CoconutTab:Section({ Title = "Auto Teleport Coconut" })

local autoCoconutState = false
local teleportDelay = 0.1 -- ระยะเวลาคอยระหว่างวาปแต่ละจุด

local function getObjectCFrame(obj)
    if obj:IsA("BasePart") then
        return obj.CFrame
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.CFrame
        else
            return obj:GetPivot()
        end
    end
    return nil
end

CoconutTab:Toggle({
    Title = "Auto Teleport Loop",
    Desc = "Teleports continuously to objects in COCONUTSSPAWN",
    Value = false,
    Callback = function(state)
        autoCoconutState = state
        
        if autoCoconutState then
            WindUI:Notify({
                Title = "Coconut Auto Loop",
                Content = "Auto Teleport Started!",
                Duration = 2
            })
            
            task.spawn(function()
                while autoCoconutState do
                    local spawnFolder = Workspace:FindFirstChild("World")
                    if spawnFolder then spawnFolder = spawnFolder:FindFirstChild("SummerFeatures") end
                    if spawnFolder then spawnFolder = spawnFolder:FindFirstChild("COCONUTSSPAWN") end

                    if spawnFolder then
                        local items = spawnFolder:GetChildren()
                        if #items > 0 then
                            for _, item in ipairs(items) do
                                if not autoCoconutState then break end
                                
                                local character = LocalPlayer.Character
                                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                                local targetCFrame = getObjectCFrame(item)

                                if hrp and targetCFrame then
                                    hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
                                    task.wait(teleportDelay)
                                end
                            end
                        else
                            task.wait(1)
                        end
                    else
                        WindUI:Notify({
                            Title = "Warning",
                            Content = "Workspace.World.SummerFeatures.COCONUTSSPAWN not found!",
                            Duration = 3
                        })
                        task.wait(2)
                    end
                    task.wait(0.1)
                end
            end)
        else
            WindUI:Notify({
                Title = "Coconut Auto Loop",
                Content = "Auto Teleport Stopped!",
                Duration = 2
            })
        end
    end
})

