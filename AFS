-- [[ Logic Functions - ใส่ฟังก์ชันเดิมของคุณทั้งหมดไว้ตรงนี้ ]]
-- (เพื่อประหยัดพื้นที่ ฉันจะเรียกใช้ตัวแปรเดิมที่คุณเขียนไว้ในระบบ Logic)

local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function pressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true,  keyCode, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- ฟังก์ชันตรวจสอบบอส (Logic เดิม)
local bossPaths = { ["Great Ape"]="GreatApe", ["Armored Titan"]="ArmoredTitan", ["Crocodile"]="Crocodile", ["Puya"]="Puya", ["SpecialGrade"]="SpecialGrade" }
local function getBossPosition(bossName)
    local folderName = bossPaths[bossName]
    local bossModel = workspace:FindFirstChild("ClientEntities") and workspace.ClientEntities:FindFirstChild(folderName)
    if not bossModel then return nil end
    return (bossModel.PrimaryPart or bossModel:FindFirstChild("HumanoidRootPart")).Position
end

local function checkAnyBossActive()
    for bossName, enabled in pairs(targetBosses) do
        if enabled and getBossPosition(bossName) then return true end
    end
    return false
end

