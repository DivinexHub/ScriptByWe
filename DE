local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser       = game:GetService("VirtualUser")
local LocalPlayer       = Players.LocalPlayer

local RemoteEvent = ReplicatedStorage
    :WaitForChild("Shared")
    :WaitForChild("Packages")
    :WaitForChild("Events")
    :WaitForChild("RemoteEvent")

local States = {
    AutoHaki      = false,
    AutoSkyEgg    = false,
    AutoRankUp    = false,
    AutoClickFast = false,
    AutoSkill     = false,
    AutoUltimate  = false,
}

local LOOP_DELAY           = 0.1
local DetectedCharacterName = nil

local function fireRemote(path, params)
    pcall(function()
        RemoteEvent:FireServer({{ Params = params, Path = path }})
    end)
end

local function getEquippedCharacterName()
    if DetectedCharacterName then return DetectedCharacterName end

    if LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then return tool.Name end

        local charFolder = LocalPlayer.Character:FindFirstChild("EquippedCharacter")
            or LocalPlayer.Character:FindFirstChild("Equipped")
        if charFolder then return charFolder.Name end
    end

    local equippedAttr = LocalPlayer:GetAttribute("EquippedCharacter")
        or LocalPlayer:GetAttribute("Equipped")
    if equippedAttr then return tostring(equippedAttr) end

    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Equipped") then
        return leaderstats.Equipped.Value
    end

    return nil
end

local Window = WindUI:CreateWindow({
    Title  = "MonHub | Anime Star Anime V1",
    Icon   = "rbxassetid://4483345998",
    Author = "WindUI",
    Folder = "CrateScriptConfig",
    Save   = true,
    Size   = UDim2.fromOffset(440, 480),
    Theme  = "Dark",
})

local MainTab = Window:Tab({ Title = "Main", Icon = "zap" })

MainTab:Slider({
    Title    = "Loop Delay (seconds)",
    Step     = 0.01,
    Value    = { Min = 0.01, Max = 1, Default = 0.1 },
    Flag     = "loopDelay",
    Callback = function(v) LOOP_DELAY = v end,
})

MainTab:Divider()
MainTab:Section({ Title = "Gacha" })

MainTab:Toggle({
    Title = "Auto Haki", Icon = "wind", Flag = "autoHaki",
    Callback = function(v)
        States.AutoHaki = v
        if v then
            fireRemote("gacha/setHidden", { "HakiGacha", true })
            task.spawn(function()
                while States.AutoHaki do
                    fireRemote("gacha/spin", { "HakiGacha", "auto" })
                    task.wait(LOOP_DELAY)
                end
            end)
        end
    end,
})

MainTab:Toggle({
    Title = "Auto Sky Egg Everywhere", Icon = "cloud", Flag = "autoSkyEgg",
    Callback = function(v)
        States.AutoSkyEgg = v
        if v then
            task.spawn(function()
                while States.AutoSkyEgg do
                    fireRemote("champions/spin", { "single", "skylands" })
                    task.wait(LOOP_DELAY)
                end
            end)
        end
    end,
})

MainTab:Divider()
MainTab:Section({ Title = "Combat" })

MainTab:Toggle({
    Title = "Auto Click Fast", Icon = "mouse-pointer-click", Flag = "autoClick",
    Callback = function(v)
        States.AutoClickFast = v
        if v then
            task.spawn(function()
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:Button1Down(Vector2.new(0, 0))
                    task.wait(0.05)
                    VirtualUser:Button1Up(Vector2.new(0, 0))
                end)

                local charName = getEquippedCharacterName()
                if not charName then
                    WindUI:Notify({ Title = "Auto Click", Content = "No unit detected — try again", Duration = 3, Icon = "alert-circle" })
                    States.AutoClickFast = false
                    return
                end

                WindUI:Notify({ Title = "Auto Click", Content = "Detected: " .. charName, Duration = 3, Icon = "check" })

                while States.AutoClickFast do
                    fireRemote("combat/m1", { charName, 1 })
                    task.wait(LOOP_DELAY)
                end
            end)
        end
    end,
})

MainTab:Toggle({
    Title = "Auto Skill", Icon = "sparkles", Flag = "autoSkill",
