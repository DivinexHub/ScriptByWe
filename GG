local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- Remote Event Reference
local RemoteEvent = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Packages"):WaitForChild("Events"):WaitForChild("RemoteEvent")

-- Toggle States
local States = {
    AutoHaki = false,
    AutoSkyEgg = false,
    AutoRankUp = false,
    AutoClickFast = false,
    AutoSkill = false,
    AutoUltimate = false
}

-- Configurable Loop Delay (seconds)
local LOOP_DELAY = 0.1

-- Helper Functions
local function fireRemote(path, params)
    RemoteEvent:FireServer({
        {
            Params = params,
            Path = path
        }
    })
end

local function getEquippedCharacterName()
    -- Check player character model first
    if LocalPlayer.Character then
        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then return tool.Name end
        
        local charFolder = LocalPlayer.Character:FindFirstChild("EquippedCharacter") or LocalPlayer.Character:FindFirstChild("Equipped")
        if charFolder then return charFolder.Name end
    end
    
    -- Check player stats / attributes fallback
    local equippedAttr = LocalPlayer:GetAttribute("EquippedCharacter") or LocalPlayer:GetAttribute("Equipped")
    if equippedAttr then return tostring(equippedAttr) end
    
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Equipped") then
        return leaderstats.Equipped.Value
    end
    
    return nil
end

-- Create Window & Tab
local Window = WindUI:CreateWindow({
    Title = "Crate Script",
    Icon = "rbxassetid://4483345998",
    Author = "WindUI",
    Folder = "CrateScriptConfig"
})

local MainTab = Window:Tab({ Title = "Main", Icon = "rbxassetid://4483345998" })

-- 1. Auto Haki
MainTab:Toggle({
    Title = "Auto Haki",
    Callback = function(Value)
        States.AutoHaki = Value
        if Value then
            fireRemote("gacha/setHidden", { "HakiGacha", true })
            task.spawn(function()
                while States.AutoHaki do
                    fireRemote("gacha/spin", { "HakiGacha", "auto" })
                    task.wait(LOOP_DELAY)
                end
            end)
        end
    end
})

