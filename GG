-- 4. Auto Click Fast
MainTab:Toggle({
    Title = "Auto Click Fast",
    Callback = function(Value)
        States.AutoClickFast = Value
        if Value then
            task.spawn(function()
                -- Initial action to register click/detect character
                local charName = getEquippedCharacterName()
                
                if not charName then
                    -- Fallback attempt: Trigger standard tool click if available
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                        charName = tool.Name
                    end
                end

                if not charName then
                    warn("[Auto Click Fast] Could not automatically detect equipped character.")
                    return
                end

                while States.AutoClickFast do
                    fireRemote("combat/m1", { charName, 1 })
                    task.wait(LOOP_DELAY)
                end
            end)
        end
    end
})

